+double GetMyDifficulty(const CBlockIndex* blockindex) {
+    if (blockindex == NULL) {
+        return 0;
+    }
+    int nShift = (blockindex->nBits >> 24) & 0xff;
+    double dDiff = (double)0x0000ffff / (double)(blockindex->nBits & 0x00ffffff);
+    while (nShift < 29) {
+        dDiff *= 256.0;
+        nShift++;
+    }
+    while (nShift > 29) {
+        dDiff /= 256.0;
+        nShift--;
+    }
+    return dDiff;
+}
