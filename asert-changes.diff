+double TargetToMyDifficulty(const uint256& target) {
+    uint32_t compactTarget = UintToArith256(target).GetCompact();
+    int nShift = (compactTarget >> 24) & 0xff;
+    double dDiff = (double)0x0000ffff / (double)(compactTarget & 0x00ffffff);
+    while (nShift < 29) {
+        dDiff *= 256.0;
+        nShift++;
+    }
+    while (nShift > 29) {
+        dDiff /= 256.0;
+        nShift--;
+    }
+    return dDiff;
+}
